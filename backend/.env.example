# In Coolify als Secrets/Environment-Variablen setzen — NICHT ins Git-Repo committen.

PORT=3000

# Woher das Frontend die API aufrufen darf
ALLOWED_ORIGIN=https://agil-medien.de

# Wohin Kontaktanfragen zugestellt werden
CONTACT_TO=kontakt@agil-medien.de

# Zufälliger, langer geheimer Wert fürs Captcha-Signing, z.B.:
# openssl rand -hex 32
CAPTCHA_SECRET=

# SMTP-Zugangsdaten deines E-Mail-Anbieters (oder eigener Mailserver)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Website AGIL Medien" <kontakt@agil-medien.de>
